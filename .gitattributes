# Plugin runtime artifacts: committed (the marketplace copies them as-is, no
# install-time build) but generated — keep them out of diffs and language stats.
libs/east-claude-plugin/.build/**     linguist-generated=true -diff
libs/east-claude-plugin/index.json    linguist-generated=true -diff
libs/east-codex-plugin/.build/**     linguist-generated=true -diff
libs/east-codex-plugin/index.json    linguist-generated=true -diff
libs/east-codex-plugin/skills/**     linguist-generated=true
libs/east-plugin/index.json          linguist-generated=true -diff

# Third-party source archives: CMake checks each against its SHA-256, so git
# must never rewrite one (a Windows checkout's line endings included).
libs/east-c/**/third_party/*.tar.gz  binary
libs/east-c/**/third_party/*.tar.xz  binary
libs/east-c/**/third_party/*.zip     binary
