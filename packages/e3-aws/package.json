{
  "name": "@elaraai/e3-aws",
  "version": "0.0.1-alpha.0",
  "private": true,
  "type": "module",
  "description": "AWS implementation for e3 cloud platform",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./storage/init": {
      "types": "./dist/src/storage/init.d.ts",
      "default": "./dist/src/storage/init.js"
    },
    "./storage/s3-object-store": {
      "types": "./dist/src/storage/s3-object-store.d.ts",
      "default": "./dist/src/storage/s3-object-store.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "node --enable-source-maps --test 'dist/src/**/*.spec.js'"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.966.0",
    "@aws-sdk/client-dynamodb": "^3.966.0",
    "@aws-sdk/client-s3": "^3.966.0",
    "@aws-sdk/client-scheduler": "^3.966.0",
    "@aws-sdk/client-sfn": "^3.966.0",
    "@aws-sdk/util-dynamodb": "^3.966.0",
    "@elaraai/e3-api-server": "beta",
    "@elaraai/e3-cloud-core": "*",
    "@elaraai/e3-cloud-types": "*",
    "hono": "^4.11.7"
  },
  "peerDependencies": {
    "@elaraai/e3-core": "beta",
    "@elaraai/e3-types": "beta",
    "@elaraai/east": "beta"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.2"
  }
}
