{
  "name": "@elaraai/e3-aws",
  "version": "0.0.1-alpha.0",
  "private": true,
  "description": "AWS cloud infrastructure for e3",
  "type": "module",
  "workspaces": [
    "cdk/accounts",
    "cdk/platform",
    "packages/*",
    "web",
    "test/integration",
    "test/manual/schedule"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test -w e3-aws-integration-tests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cdk": "npm run cdk --workspace=@elaraai/e3-platform",
    "dev": "npm run dev --workspace=@elaraai/e3-web",
    "link": "npm run build --workspace=@elaraai/e3-cloud-cli && npm link --workspace=@elaraai/e3-cloud-cli",
    "wipe:dev": "./scripts/wipe-dev-data.sh"
  },
  "keywords": [
    "e3",
    "aws",
    "cdk",
    "cloud",
    "infrastructure"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@elaraai/e3-api-client": "beta",
    "@elaraai/e3-api-server": "beta",
    "@elaraai/e3-api-tests": "beta"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.0.0",
    "eslint-plugin-headers": "^1.3.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
