{
  "name": "@elaraai/e3-aws",
  "version": "0.0.1-alpha.0",
  "private": true,
  "description": "AWS cloud infrastructure for e3",
  "type": "module",
  "workspaces": [
    "cdk/accounts",
    "cdk/platform",
    "packages/*",
    "web",
    "test/integration"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test -w e3-aws-integration-tests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cdk": "npm run cdk --workspace=@elaraai/e3-platform",
    "dev": "npm run dev --workspace=@elaraai/e3-web"
  },
  "keywords": [
    "e3",
    "aws",
    "cdk",
    "cloud",
    "infrastructure"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@elaraai/e3-api-client": "^0.0.2-beta.20",
    "@elaraai/e3-api-server": "^0.0.2-beta.20",
    "@elaraai/e3-api-tests": "^0.0.2-beta.20",
    "@elaraai/e3-core": "^0.0.2-beta.20",
    "@elaraai/e3-types": "^0.0.2-beta.20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.0.0",
    "eslint-plugin-headers": "^1.3.3",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
