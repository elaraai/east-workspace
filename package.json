{
  "name": "east-monorepo",
  "version": "1.0.46",
  "private": true,
  "description": "East language monorepo",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "test:export": "pnpm -r run test:export"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "better-sqlite3",
      "cpu-features",
      "esbuild",
      "keytar",
      "ssh2"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    }
  }
}
