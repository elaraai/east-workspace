{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://elaraai.com/schemas/e3-deployment.json",
  "title": "E3 Deployment Configuration",
  "description": "Configuration for an e3 platform deployment",
  "type": "object",
  "required": ["name", "aws", "deployment"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for IDE support"
    },
    "name": {
      "type": "string",
      "description": "Unique deployment name (e.g., elara-dev, acme-prod)",
      "pattern": "^[a-z0-9-]+$"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of this deployment"
    },
    "aws": {
      "type": "object",
      "description": "AWS account and authentication settings",
      "required": ["accountId", "region", "profile"],
      "properties": {
        "accountId": {
          "type": "string",
          "description": "AWS account ID (12 digits)",
          "pattern": "^[0-9]{12}$"
        },
        "region": {
          "type": "string",
          "description": "AWS region for deployment",
          "default": "ap-southeast-2"
        },
        "profile": {
          "type": "string",
          "description": "AWS CLI profile name for authentication"
        }
      }
    },
    "deployment": {
      "type": "object",
      "description": "Deployment-specific settings",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Deployment ID used in resource naming and subdomain (e.g., dev, prod, acme)",
          "pattern": "^[a-z0-9-]+$"
        },
        "callbackUrls": {
          "type": "array",
          "description": "Additional OAuth callback URLs",
          "items": { "type": "string", "format": "uri" }
        },
        "allowedOrigins": {
          "type": "array",
          "description": "Additional CORS allowed origins",
          "items": { "type": "string", "format": "uri" }
        }
      }
    },
    "domain": {
      "type": "object",
      "description": "Custom domain configuration (optional - omit to use CloudFront domain)",
      "required": ["baseDomain", "hostedZoneId"],
      "properties": {
        "baseDomain": {
          "type": "string",
          "description": "Base domain for the platform (e.g., e3.elaraai.com)",
          "format": "hostname"
        },
        "hostedZoneId": {
          "type": "string",
          "description": "Route53 hosted zone ID for the base domain",
          "pattern": "^Z[A-Z0-9]+$"
        },
        "route53RoleArn": {
          "type": "string",
          "description": "IAM role ARN for cross-account Route53 access (only needed if hosted zone is in different account)",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/.+$"
        }
      }
    },
    "oidc": {
      "type": "object",
      "description": "OIDC identity provider configuration (optional)",
      "required": ["providerName", "clientId", "issuerUrl", "clientSecretArn"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable OIDC identity provider",
          "default": true
        },
        "providerName": {
          "type": "string",
          "description": "Display name for the identity provider (e.g., AzureAD)"
        },
        "clientId": {
          "type": "string",
          "description": "OIDC client ID"
        },
        "issuerUrl": {
          "type": "string",
          "description": "OIDC issuer URL",
          "format": "uri"
        },
        "clientSecretArn": {
          "type": "string",
          "description": "ARN of Secrets Manager secret containing OIDC client secret",
          "pattern": "^arn:aws:secretsmanager:.+$"
        },
        "adminGroup": {
          "type": "string",
          "description": "IdP group name that grants admin access (must match exactly)",
          "default": "e3-admins"
        }
      }
    },
    "github": {
      "type": "object",
      "description": "GitHub Actions deployment configuration",
      "properties": {
        "deployRoleArn": {
          "type": "string",
          "description": "IAM role ARN for GitHub Actions OIDC deployment",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/.+$"
        }
      }
    },
    "testUsers": {
      "type": "object",
      "description": "Test user configuration for integration testing",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Create test users in Cognito for integration testing",
          "default": false
        },
        "emailDomain": {
          "type": "string",
          "description": "Domain for test user email addresses",
          "default": "test.elaraai.com"
        }
      }
    }
  }
}
