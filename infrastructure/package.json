{
  "name": "@elaraai/e3-aws-infrastructure",
  "version": "0.0.1-alpha.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK infrastructure for e3 cloud",
  "main": "dist/bin/e3-aws.js",
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc --build --watch",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "deploy:prod": "cdk deploy --context deploymentId=prod --context callbackUrls='[\"https://platform.elaraai.com/callback\"]' --context allowedOrigins='[\"https://platform.elaraai.com\"]'",
    "destroy": "cdk destroy",
    "outputs": "aws cloudformation describe-stacks --query 'Stacks[0].Outputs' --output table",
    "test:integration": "vitest run",
    "test:integration:watch": "vitest"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.700.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-efs": "^3.700.0",
    "@aws-sdk/client-sfn": "^3.700.0",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.170.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
