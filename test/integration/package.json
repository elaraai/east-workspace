{
  "name": "e3-aws-integration-tests",
  "version": "0.0.1-alpha.0",
  "private": true,
  "type": "module",
  "description": "Integration tests for e3-aws cloud deployment",
  "scripts": {
    "build": "tsc --build",
    "test": "npm run build && node --enable-source-maps --test 'dist/**/*.spec.js'",
    "test:infra": "npm run build && node --enable-source-maps --test 'dist/cloud-infra.spec.js'",
    "test:api": "npm run build && node --enable-source-maps --test 'dist/api-compliance.spec.js'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@elaraai/e3-api-tests": "^0.0.2-beta.21",
    "@elaraai/e3-api-client": "^0.0.2-beta.21",
    "@elaraai/e3-admin-tests": "^0.0.1-alpha.0",
    "@aws-sdk/client-cloudformation": "^3.966.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.966.0",
    "@aws-sdk/client-dynamodb": "^3.966.0",
    "@aws-sdk/client-s3": "^3.966.0",
    "@aws-sdk/client-secrets-manager": "^3.966.0",
    "@aws-sdk/client-sfn": "^3.966.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.2"
  }
}
