# Lambda Runner Container Image
#
# Built with: docker buildx build --output compression=zstd,oci-mediatypes=true
# zstd compression + SOCI lazy loading reduces Fargate cold starts significantly.
#
# Based on ghcr.io/elaraai/e3 which includes:
# - Node.js 22
# - Python 3.11 + east-py + east-py-std + east-py-io + east-py-datascience
# - e3 CLI and packages
#
# This image adds:
# - AWS Lambda Runtime Interface Client for Node.js
# - Runner handler code for task execution

FROM ghcr.io/elaraai/e3:beta

# Install build dependencies for aws-lambda-ric and then the RIC itself
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    g++ \
    make \
    autoconf \
    automake \
    libtool \
    libcurl4-openssl-dev \
    xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g aws-lambda-ric

# Create app directory
WORKDIR /var/task

# Copy compiled e3-aws package (handlers use relative imports to storage/)
COPY packages/e3-aws/dist/src ./dist/src

# Create minimal package.json with only needed dependencies and install
RUN echo '{"type":"module","dependencies":{"@aws-sdk/client-s3":"^3.966.0","@aws-sdk/client-dynamodb":"^3.966.0","@aws-sdk/util-dynamodb":"^3.966.0","@aws-sdk/client-sfn":"^3.966.0","@aws-sdk/s3-request-presigner":"^3.966.0"}}' > package.json \
    && npm install --omit=dev

# Copy local @elaraai packages AFTER npm install (to avoid being cleaned up)
# Must preserve the dist/src structure to match package.json "main": "dist/src/index.js"
COPY packages/e3-cloud-core/dist/src ./node_modules/@elaraai/e3-cloud-core/dist/src
COPY packages/e3-cloud-core/package.json ./node_modules/@elaraai/e3-cloud-core/
COPY packages/e3-cloud-types/dist/src ./node_modules/@elaraai/e3-cloud-types/dist/src
COPY packages/e3-cloud-types/package.json ./node_modules/@elaraai/e3-cloud-types/

# Link @elaraai packages from global node_modules (installed in base image)
# execute-task-core.ts imports inputsHash from @elaraai/e3-core at runtime
RUN mkdir -p node_modules/@elaraai \
    && for pkg in e3-core e3-types e3 east; do \
         ln -s /usr/local/lib/node_modules/@elaraai/$pkg node_modules/@elaraai/$pkg 2>/dev/null || true; \
       done

# Lambda entrypoint - use aws-lambda-ric to bootstrap
ENTRYPOINT ["/usr/local/bin/npx", "aws-lambda-ric"]

# Default handler - execute-task
CMD ["dist/src/handlers/sfn/execute-task.handler"]
