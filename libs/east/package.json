{
  "name": "@elaraai/east",
  "version": "1.0.4",
  "description": "East is a simple and fast language used by Elara AI Pty Ltd.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./internal": {
      "types": "./dist/src/internal.d.ts",
      "default": "./dist/src/internal.js"
    }
  },
  "files": [
    "dist/src",
    "!dist/src/**/*.spec.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "package": "npm run build && mkdir -p .package && npm pack --pack-destination .package",
    "prepublishOnly": "npm run build",
    "example": "node --enable-source-maps dist/contrib/examples/example.js",
    "example:async": "node --enable-source-maps dist/contrib/examples/async.js",
    "test": "npm run build && node --enable-source-maps --test-reporter=spec --test 'dist/test/**/*.spec.js' 'dist/src/**/*.spec.js'",
    "test:coverage": "npm run build && node --enable-source-maps --test-reporter=spec --test --experimental-test-coverage 'dist/test/**/*.spec.js' 'dist/src/**/*.spec.js'",
    "test:export": "npm run build && rm -rf /tmp/east-test-ir && EXPORT_TEST_IR=/tmp/east-test-ir node --enable-source-maps --test-reporter=spec --test 'dist/test/**/*.spec.js'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elaraai/east-workspace.git",
    "directory": "libs/east"
  },
  "keywords": [
    "east",
    "elara",
    "language",
    "compiler",
    "interpreter",
    "ast"
  ],
  "author": "Elara AI Pty Ltd",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.34.0",
    "eslint-plugin-headers": "^1.3.3",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "sorted-btree": "^1.8.1"
  }
}
