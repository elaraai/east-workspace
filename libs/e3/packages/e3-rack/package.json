{
  "name": "@elaraai/e3-rack",
  "version": "1.0.86",
  "type": "module",
  "description": "Rack protocol, local hub and task delegation for e3",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./protocol": {
      "types": "./dist/src/protocol/index.d.ts",
      "default": "./dist/src/protocol/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "default": "./dist/src/testing/index.js"
    },
    "./hub-main": {
      "types": "./dist/src/hub/main.d.ts",
      "default": "./dist/src/hub/main.js"
    }
  },
  "files": [
    "dist/src",
    "!dist/src/**/*.spec.*",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --enable-source-maps --test-reporter=spec --test-timeout=480000 --test 'dist/src/**/*.spec.js'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "east",
    "e3",
    "rack"
  ],
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elaraai/east-workspace.git",
    "directory": "libs/e3/packages/e3-rack"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "dependencies": {
    "@elaraai/e3-core": "workspace:*",
    "@elaraai/e3-types": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "@elaraai/e3-api-server": "workspace:*",
    "@elaraai/e3": "workspace:*"
  },
  "peerDependencies": {
    "@elaraai/east": "workspace:*"
  },
  "devDependencies": {
    "@elaraai/east-node-cli": "workspace:*",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.0.0",
    "eslint-plugin-headers": "^1.3.3",
    "typescript": "^5.6.0"
  }
}
