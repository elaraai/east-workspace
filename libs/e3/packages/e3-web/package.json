{
  "name": "@elaraai/e3-web",
  "version": "1.0.84",
  "type": "module",
  "description": "East Execution Engine in the browser - e3's storage over IndexedDB, OPFS and Web Locks",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./units": {
      "types": "./dist/src/units.d.ts",
      "default": "./dist/src/units.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "default": "./dist/src/node.js"
    }
  },
  "files": [
    "dist/src",
    "!dist/src/**/*.spec.*",
    "!dist/src/browser/**",
    "!dist/src/testing/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --enable-source-maps --test-reporter=spec --test-timeout=480000 --test 'dist/src/**/*.spec.js'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "east",
    "e3",
    "browser",
    "indexeddb",
    "opfs"
  ],
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elaraai/east-workspace.git",
    "directory": "libs/e3/packages/e3-web"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "dependencies": {
    "@elaraai/e3-core": "workspace:*",
    "@elaraai/e3-types": "workspace:*",
    "@elaraai/east-web-std": "workspace:*"
  },
  "peerDependencies": {
    "@elaraai/east": "workspace:*"
  },
  "devDependencies": {
    "@elaraai/e3": "workspace:*",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.0.0",
    "eslint-plugin-headers": "^1.3.3",
    "playwright-core": "~1.59.0",
    "typescript": "^5.6.0"
  }
}
