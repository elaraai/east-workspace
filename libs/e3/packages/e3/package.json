{
  "name": "@elaraai/e3",
  "version": "1.0.35",
  "description": "TypeScript SDK for authoring e3 packages",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "default": "./dist/src/browser.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "test": "node --enable-source-maps --test-reporter=spec --test 'dist/src/**/*.spec.js'"
  },
  "dependencies": {
    "@elaraai/e3-types": "workspace:*",
    "smol-toml": "^1.3.1",
    "yazl": "^2.5.1"
  },
  "peerDependencies": {
    "@elaraai/east": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "typescript": "^5.7.2",
    "yauzl": "^3.2.0"
  },
  "files": [
    "dist"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elaraai/east-workspace.git",
    "directory": "libs/e3/packages/e3"
  }
}
