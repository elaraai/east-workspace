{
  "name": "@elaraai/east-ui-components",
  "version": "1.0.25",
  "description": "React components for rendering East UI types with Chakra UI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js",
      "require": "./dist/fonts.cjs"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js",
      "require": "./dist/platform.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "CONTRIBUTING.md",
    "CLA.md"
  ],
  "sideEffects": [
    "./dist/platform/state-runtime.js",
    "./src/platform/state-runtime.ts",
    "./dist/platform/clipboard/index.js",
    "./src/platform/clipboard/index.ts",
    "./dist/platform/download/index.js",
    "./src/platform/download/index.ts",
    "./dist/platform/share/index.js",
    "./src/platform/share/index.ts",
    "./dist/feedback/toast/index.js",
    "./src/feedback/toast/index.tsx",
    "./dist/overlays/overlay-manager.js",
    "./src/overlays/overlay-manager.tsx"
  ],
  "scripts": {
    "prebuild": "pnpm chakra:typegen",
    "build": "vite build",
    "chakra:typegen": "chakra typegen src/theme/index.ts --strict",
    "chakra:typegen:watch": "chakra typegen src/theme/index.ts --strict --watch src/theme",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test-reporter=spec --test test/**/*.spec.ts && vitest run",
    "test:watch": "node --import tsx --test-reporter=spec --test --watch test/**/*.spec.ts",
    "test:components": "vitest run",
    "snapshot": "tsx scripts/snapshot.ts"
  },
  "peerDependencies": {
    "@elaraai/east": "workspace:*",
    "@elaraai/east-ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@chakra-ui/charts": "^3.30.0",
    "@chakra-ui/react": "^3.0.0",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/inter-tight": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@internationalized/date": "^3.8.0",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@react-aria/datepicker": "^3.14.0",
    "@react-aria/i18n": "^3.12.8",
    "@react-stately/datepicker": "^3.14.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.9",
    "@use-gesture/react": "^10.3.1",
    "@visx/axis": "^3.12.0",
    "@visx/brush": "^3.12.0",
    "@visx/curve": "^3.12.0",
    "@visx/grid": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/responsive": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/tooltip": "^3.12.0",
    "d3-time": "^3.1.0",
    "h3-js": "^4.1.0",
    "leaflet": "^1.9.4",
    "rbush": "^4.0.1",
    "react-markdown": "^9.0.0",
    "recharts": "3.5.1",
    "remark-gfm": "^4.0.0",
    "sorted-btree": "^2.0.0-alpha.0",
    "use-local-storage-state": "^19.5.0"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.35.0",
    "@elaraai/east-node-std": "workspace:*",
    "@fortawesome/fontawesome-common-types": "^7.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-time": "^3.0.4",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.18.1",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.0.14",
    "eslint": "^9.34.0",
    "eslint-plugin-headers": "^1.3.3",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.0.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elaraai/east-workspace.git",
    "directory": "libs/east-ui/packages/east-ui-components"
  },
  "keywords": [
    "east",
    "elara",
    "ui",
    "react",
    "chakra"
  ],
  "author": "Elara AI Pty Ltd",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.0.0"
  }
}
