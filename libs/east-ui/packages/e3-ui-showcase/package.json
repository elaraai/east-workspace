{
  "name": "@elaraai/e3-ui-showcase",
  "version": "1.0.0-beta.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "description": "E3 Ui Showcase",
  "type": "module",
  "scripts": {
    "build": "node --max-old-space-size=16000 ./node_modules/typescript/bin/tsc",
    "test": "node --enable-source-maps --test 'dist/**/*.spec.js'",
    "test:export": "rm -rf /tmp/e3-ui-showcase-tests && EXPORT_TEST_IR=/tmp/e3-ui-showcase-tests node --enable-source-maps --test 'dist/**/*.spec.js' 2>&1 | grep 'Exported test IR'",
    "lint": "eslint ."
  },
  "dependencies": {
    "@elaraai/east": "workspace:*",
    "@elaraai/east-node-std": "workspace:*",
    "@elaraai/east-node-io": "workspace:*",
    "@elaraai/e3": "workspace:*",
    "@elaraai/e3-types": "workspace:*",
    "@elaraai/e3-ui": "workspace:*",
    "@elaraai/east-ui": "workspace:*"
  },
  "devDependencies": {
    "@elaraai/east-node-cli": "workspace:*",
    "@elaraai/east-c-cli": "workspace:*",
    "@types/node": "^22",
    "typescript": "^5",
    "eslint": "^9",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elaraai/east-workspace.git",
    "directory": "libs/east-ui/packages/e3-ui-showcase"
  }
}
