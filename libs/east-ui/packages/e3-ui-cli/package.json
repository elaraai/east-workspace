{
  "name": "@elaraai/e3-ui-cli",
  "version": "1.0.27",
  "description": "Render east-ui / e3-ui components to PNG from the command line (e3-ui shot)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "e3-ui": "./bin/e3-ui.mjs"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.spec.*",
    "README.md",
    "LICENSE.md",
    "CONTRIBUTING.md",
    "CLA.md"
  ],
  "scripts": {
    "build": "tsc && tsc -p app/tsconfig.json && node scripts/build-app.mjs",
    "test": "npm run build && node --enable-source-maps --test-reporter=spec --test 'dist/**/*.spec.js'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "npm run build && node --enable-source-maps dist/cli.js"
  },
  "keywords": [
    "east",
    "elara",
    "e3",
    "ui",
    "cli",
    "screenshot",
    "png",
    "render"
  ],
  "author": "Elara AI Pty Ltd",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elaraai/east-workspace.git",
    "directory": "libs/east-ui/packages/e3-ui-cli"
  },
  "dependencies": {
    "@elaraai/e3-api-server": "workspace:*",
    "commander": "^12.0.0",
    "esbuild": "^0.27.2",
    "playwright": "^1.49.0"
  },
  "peerDependencies": {
    "@elaraai/east": "workspace:*"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.0.0",
    "@elaraai/east-ui": "workspace:*",
    "@elaraai/east-ui-components": "workspace:*",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/inter-tight": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@elaraai/e3-api-client": "workspace:*",
    "@elaraai/e3-types": "workspace:*",
    "@elaraai/e3-ui": "workspace:*",
    "@elaraai/e3-ui-components": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-headers": "^1.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.2",
    "vite": "^6.0.0"
  }
}
