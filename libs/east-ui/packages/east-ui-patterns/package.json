{
  "name": "@elaraai/east-ui-patterns",
  "version": "1.0.0-beta.0",
  "description": "Decision-quality UI patterns for the East language. Pattern declarations only — React renderers live in @elaraai/east-ui-patterns-components.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./decision": {
      "types": "./dist/src/decision/index.d.ts",
      "default": "./dist/src/decision/index.js"
    },
    "./decision/brief": {
      "types": "./dist/src/decision/brief/index.d.ts",
      "default": "./dist/src/decision/brief/index.js"
    },
    "./examples/decision/brief": {
      "types":   "./dist/test/decision/brief.examples.d.ts",
      "default": "./dist/test/decision/brief.examples.js"
    },
    "./examples/decision/*": {
      "types":   "./dist/test/decision/*.examples.d.ts",
      "default": "./dist/test/decision/*.examples.js"
    }
  },
  "files": [
    "dist/src",
    "dist/test/**/*.examples.*",
    "!dist/src/**/*.spec.*",
    "README.md",
    "LICENSE.md",
    "CONTRIBUTING.md",
    "CLA.md"
  ],
  "scripts": {
    "build": "tsc",
    "package": "npm run build && mkdir -p .package && npm pack --pack-destination .package",
    "prepublishOnly": "npm run lint && npm run test",
    "test": "npm run build && npm run lint && node --enable-source-maps --test-reporter=spec --test 'dist/test/**/*.spec.js' 'dist/src/**/*.spec.js'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elaraai/east-ui.git",
    "directory": "packages/east-ui-patterns"
  },
  "keywords": [
    "east",
    "elara",
    "ui",
    "patterns",
    "decision",
    "decision-quality",
    "recommendation"
  ],
  "author": "Elara AI Pty Ltd",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@elaraai/east-node-std": "workspace:*",
    "@types/node": "^22.18.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.34.0",
    "eslint-plugin-headers": "^1.3.3",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "@elaraai/east": "workspace:*",
    "@elaraai/east-ui": "workspace:*"
  }
}
