{
  "name": "@elaraai/east-ui-patterns-components",
  "version": "1.0.0-beta.0",
  "description": "React (Chakra v3) renderers for the decision-quality patterns declared in @elaraai/east-ui-patterns.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "CONTRIBUTING.md",
    "CLA.md"
  ],
  "sideEffects": [
    "./dist/decision/brief/view.js",
    "./src/decision/brief/view.tsx"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elaraai/east-ui.git",
    "directory": "packages/east-ui-patterns-components"
  },
  "keywords": [
    "east",
    "elara",
    "ui",
    "patterns",
    "chakra",
    "react",
    "decision-quality"
  ],
  "author": "Elara AI Pty Ltd",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.0.0",
    "@elaraai/east": "workspace:*",
    "@elaraai/east-ui": "workspace:*",
    "@elaraai/east-ui-components": "workspace:*",
    "@elaraai/east-ui-patterns": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.34.0",
    "eslint-plugin-headers": "^1.3.3",
    "typescript": "~5.9.2",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
