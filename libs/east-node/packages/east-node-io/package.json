{
  "name": "@elaraai/east-node-io",
  "version": "1.0.21",
  "description": "I/O platform functions for the East language on Node.js",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./platform": {
      "types": "./dist/src/platform.d.ts",
      "default": "./dist/src/platform.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "!dist/**/*.spec.*",
    "README.md",
    "LICENSE.md",
    "CONTRIBUTING.md",
    "CLA.md"
  ],
  "scripts": {
    "build": "tsc",
    "package": "npm run build && mkdir -p .package && npm pack --pack-destination .package",
    "test": "npm run build && node --enable-source-maps --test-reporter=spec --test 'dist/test/**/*.spec.js'",
    "test:check": "tsc -p tsconfig.test.json",
    "test:coverage": "npm run build && node --enable-source-maps --test-reporter=spec --test --experimental-test-coverage 'dist/test/**/*.spec.js'",
    "test:export": "npm run build && rm -rf /tmp/east-node-io && EXPORT_TEST_IR=/tmp/east-node-io npm test 2>&1 | grep 'Exported test IR'",
    "test:integration": "npm run test:docker:up && npm test && npm run test:docker:down",
    "test:docker:up": "docker-compose up -d && npm run test:wait",
    "test:docker:down": "docker-compose down -v",
    "test:wait": "node --enable-source-maps dist/scripts/wait-for-services.js",
    "dev:services": "docker-compose up -d",
    "dev:services:down": "docker-compose down -v",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elaraai/east-workspace.git",
    "directory": "libs/east-node/packages/east-node-io"
  },
  "keywords": [
    "east",
    "elara",
    "node",
    "io",
    "database",
    "sql",
    "nosql",
    "access",
    "mdb",
    "s3",
    "ftp",
    "sftp",
    "platform"
  ],
  "author": "Elara AI Pty Ltd",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@elaraai/east-node-std": "workspace:*",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.11.10",
    "@types/ssh2-sftp-client": "^9.0.5",
    "@types/tar-stream": "^3.1.4",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.34.0",
    "eslint-plugin-headers": "^1.3.3",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.713.0",
    "@aws-sdk/s3-request-presigner": "^3.713.0",
    "adm-zip": "^0.5.16",
    "basic-ftp": "^5.0.5",
    "better-sqlite3": "^11.0.0",
    "ioredis": "^5.4.2",
    "mdb-reader": "^3.1.0",
    "mongodb": "^6.11.0",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "ssh2-sftp-client": "^11.0.0",
    "tar-stream": "^3.1.7",
    "xlsx": "^0.18.5"
  },
  "peerDependencies": {
    "@elaraai/east": "workspace:*",
    "@elaraai/east-node-std": "workspace:*"
  }
}
