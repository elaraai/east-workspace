{
  "description": "East plugin hooks: project detection, the search-before-coding gate, and preemptive diagnostics (files edited, read, or written through the shell)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/.build/hooks/session-start.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/.build/hooks/subagent-start.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Bash|exec_command|shell_command|Read|Edit|Write|Grep|Glob|mcp__.*__(?:search_east_examples|get_east_example)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/.build/hooks/codex-tools.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Bash|exec_command|shell_command|Read|Edit|Write|Grep|Glob|mcp__.*__(?:search_east_examples|get_east_example)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/.build/hooks/codex-tools.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
