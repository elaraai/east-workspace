# East Python Runtime (BUSL-1.1 + AGPL-3.0)
# Python runtime for East programs — east-py + std + io, NO datascience.
#
# This is the slim python cloud tier (elaraai/east-workspace#299): the
# datascience stack (torch, sklearn, pymc, …) is what makes the `e3`
# everything-image multi-GB, so it lives in the east-py-datascience image
# (FROM this one) and is only pulled when a task actually uses it. The node
# base provides the runtime shims cloud runners layer on top (aws-lambda-ric
# et al); no node East packages are installed — an east_py task needs only
# the python runtime.
#
# License: Contains BUSL-1.1 components - production use requires commercial license
# See: https://github.com/elaraai/e3/blob/main/LICENSE.md
#
# Usage:
#   docker build -f Dockerfile.east-py -t ghcr.io/elaraai/east-py .
#   docker run --rm -v $(pwd):/workspace ghcr.io/elaraai/east-py east-py run program.east
#
# Python is 3.12, and its virtualenv (/opt/venv, on PATH) holds no pip. An
# image built FROM this one adds packages with uv, which installs into it:
#   RUN uv pip install <package>

FROM node:22-slim AS base

LABEL org.opencontainers.image.source="https://github.com/elaraai/east-workspace"
LABEL org.opencontainers.image.description="East Python Runtime (no datascience) - BUSL-1.1 + AGPL-3.0"
LABEL org.opencontainers.image.licenses="BUSL-1.1 AND AGPL-3.0"

# Python east-py (PyPI), pinned to the lockstep release so the runtime
# evaluates the same-version IR the release's compiler emits.
ARG EAST_PY_VERSION
ENV EAST_PY_VERSION=${EAST_PY_VERSION:-latest}

# System dependencies: gcc for an extension that builds from source (Cython,
# numba). Python is not the system's (below).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    curl \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install uv for Python package management
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Python 3.12, as uv builds it, which the east-py packages need: the system's
# is 3.11. Kept under /opt/python, which every user of the image reads; it
# carries its own headers, for an extension that builds from source. Linked
# as python3.12 on every user's PATH, where uv finds it for a virtualenv of
# 3.12. /opt/python is where this install puts it, not uv's setting: a Python
# uv fetches later, for an environment of another, goes where it would for
# that user, which /opt/python, root's, is not.
RUN UV_PYTHON_INSTALL_DIR=/opt/python uv python install 3.12 && \
    ln -sf "$(UV_PYTHON_INSTALL_DIR=/opt/python uv python find --managed-python 3.12)" /usr/local/bin/python3.12

# The virtualenv the image's tasks run in, made by that Python, without pip:
# it then holds what install-packages.sh installs into it with uv, under a
# release's pins, and its tier manifest names nothing else. Made with pip, it
# would also hold the pip and setuptools a Python seeds a virtualenv with,
# which no package here needs, at versions the release's pins do not.
RUN "$(UV_PYTHON_INSTALL_DIR=/opt/python uv python find --managed-python 3.12)" -m venv --without-pip /opt/venv
ENV VIRTUAL_ENV="/opt/venv"
ENV PATH="/opt/venv/bin:$PATH"

# Set working directory
WORKDIR /workspace

# Cache-bust knob for the version-pinned PyPI install in install-packages.sh
# (see Dockerfile.e3).
ARG EAST_PY_CACHEBUST=0

# Copy and run install script (python packages minus datascience). A named
# release is installed under its pins: the east-py workspace's lock, exported,
# with its overrides, as the release's published @elaraai/e3-core ships them
# (e3: a project and its tier resolve the same torch). The script fetches
# them into /opt/e3, where they stay: the image then holds the build of
# everything the release was tested with. `latest` is unconstrained, and
# keeps none.
COPY docker/images/install-packages.sh /tmp/install-packages.sh
RUN chmod +x /tmp/install-packages.sh && \
    EAST_PY_PINS_DIR=/opt/e3 /tmp/install-packages.sh --py-only && \
    rm /tmp/install-packages.sh

# What this image holds, for an environment built over it: its tier manifest
# (e3: environments built over their base tier). Written last, by the
# interpreter the image's tasks run with, so it names everything installed.
COPY libs/e3/packages/e3-core/tier/tier-manifest.py /tmp/tier-manifest.py
RUN mkdir -p /opt/e3 && \
    /opt/venv/bin/python /tmp/tier-manifest.py /opt/e3/tier-manifest.json && \
    rm /tmp/tier-manifest.py

# Default command
CMD ["bash"]
