# East C Runtime (BUSL-1.1)
# Native east-c evaluator for East programs — the prebuilt east-c binary from
# the published npm package, nothing else (elaraai/east-workspace#299).
#
# east-c-cli is BUSL-1.1, so it cannot ride in the AGPL-only east-node image —
# hence this tiny dedicated image for the east_c cloud tier. The node base
# provides npm (for the install) and the runtime shims cloud runners layer on
# top.
#
# License: Contains BUSL-1.1 components - production use requires commercial license
# See: https://github.com/elaraai/e3/blob/main/LICENSE.md
#
# Usage:
#   docker build -f Dockerfile.east-c -t ghcr.io/elaraai/east-c .
#   docker run --rm -v $(pwd):/workspace ghcr.io/elaraai/east-c east-c run program.beast2

FROM node:22-slim AS base

LABEL org.opencontainers.image.source="https://github.com/elaraai/east-workspace"
LABEL org.opencontainers.image.description="East C Runtime - BUSL-1.1"
LABEL org.opencontainers.image.licenses="BUSL-1.1"

# Native east-c (npm @elaraai/east-c-cli), pinned to the lockstep release so
# the evaluator matches the release compiler's IR format.
ARG EAST_C_CLI_VERSION
ENV EAST_C_CLI_VERSION=${EAST_C_CLI_VERSION:-latest}

# System dependencies. libcurl4 is a RUNTIME link dependency of the prebuilt
# east-c binary (node:22-slim doesn't ship it) — without it the evaluator
# dies at exec with "error while loading shared libraries: libcurl.so.4"
# anywhere this base is used directly (found live on e3-cloud rack microVMs,
# issue #336; the e3-cloud runner image only worked by installing it itself).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libcurl4 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Copy and run install script (east-c only — reuses its binary-hoist logic:
# npm nests the per-platform prebuilt under east-c-cli and doesn't link a
# transitive dep's bin onto PATH).
COPY docker/images/install-packages.sh /tmp/install-packages.sh
RUN chmod +x /tmp/install-packages.sh && \
    /tmp/install-packages.sh --c-only && \
    rm /tmp/install-packages.sh

# Default command
CMD ["bash"]
