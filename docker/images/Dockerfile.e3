# e3 - East Execution Engine (BSL 1.1 + AGPL-3.0)
# Full platform with Node.js + Python runtimes for durable execution
#
# License: Contains BSL 1.1 components - production use requires commercial license
# See: https://github.com/elaraai/e3/blob/main/LICENSE.md
#
# Usage:
#   docker build -f Dockerfile.e3 -t ghcr.io/elaraai/e3 .
#   docker run --rm -v $(pwd):/workspace ghcr.io/elaraai/e3 e3 run my-pipeline

# east-c, east-node and east-py are ALL installed from the published, lockstep
# release artifacts (npm / PyPI) by install-packages.sh — pinned via
# EAST_C_CLI_VERSION / EAST_PY_VERSION below. Previously east-c was git-cloned
# from `main` and built from source here, which drifted out of lockstep with
# the npm/PyPI packages: the image shipped an east-c whose IR format didn't
# match the release's compiler, so every east-c task failed with
# "Failed to decode Beast2 IR". Installing the released east-c-cli binary (the
# same one `npm create` projects use) keeps all three runtimes in lockstep.
FROM node:22-slim AS base

LABEL org.opencontainers.image.source="https://github.com/elaraai/east-workspace"
LABEL org.opencontainers.image.description="e3 - East Execution Engine (BSL 1.1 + AGPL-3.0)"
LABEL org.opencontainers.image.licenses="BSL-1.1 AND AGPL-3.0"

# Build args for package versions (queried from npm in workflow)
ARG EAST_VERSION
ARG EAST_NODE_STD_VERSION
ARG EAST_NODE_IO_VERSION
ARG EAST_NODE_CLI_VERSION
ARG EAST_UI_VERSION
ARG E3_VERSION
ARG E3_TYPES_VERSION
ARG E3_CORE_VERSION
ARG E3_CLI_VERSION
ARG E3_API_CLIENT_VERSION
ARG E3_API_SERVER_VERSION
# Native east-c (npm @elaraai/east-c-cli) + Python east-py (PyPI), pinned to
# the lockstep release so all three runtimes evaluate the same-version IR.
ARG EAST_C_CLI_VERSION
ARG EAST_PY_VERSION

# Pass build args as environment variables for install script
ENV EAST_VERSION=${EAST_VERSION:-latest}
ENV EAST_NODE_STD_VERSION=${EAST_NODE_STD_VERSION:-latest}
ENV EAST_NODE_IO_VERSION=${EAST_NODE_IO_VERSION:-latest}
ENV EAST_NODE_CLI_VERSION=${EAST_NODE_CLI_VERSION:-latest}
ENV EAST_UI_VERSION=${EAST_UI_VERSION:-latest}
ENV E3_VERSION=${E3_VERSION:-latest}
ENV E3_TYPES_VERSION=${E3_TYPES_VERSION:-latest}
ENV E3_CORE_VERSION=${E3_CORE_VERSION:-latest}
ENV E3_CLI_VERSION=${E3_CLI_VERSION:-latest}
ENV E3_API_CLIENT_VERSION=${E3_API_CLIENT_VERSION:-latest}
ENV E3_API_SERVER_VERSION=${E3_API_SERVER_VERSION:-latest}
ENV EAST_C_CLI_VERSION=${EAST_C_CLI_VERSION:-latest}
ENV EAST_PY_VERSION=${EAST_PY_VERSION:-latest}

# Install system dependencies: a C compiler for Cython extensions. Python is
# not the system's (below).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    curl \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install uv for Python package management
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Python 3.12, as uv builds it, which the east-py packages need: the system's
# is 3.11. Kept under /opt/python, which every user of the image reads, and
# linked as python3.12 on every user's PATH, where uv finds it for a
# virtualenv of 3.12. /opt/python is where this install puts it, not uv's
# setting: a Python uv fetches later, for an environment of another, goes
# where it would for that user, which /opt/python, root's, is not.
RUN UV_PYTHON_INSTALL_DIR=/opt/python uv python install 3.12 && \
    ln -sf "$(UV_PYTHON_INSTALL_DIR=/opt/python uv python find --managed-python 3.12)" /usr/local/bin/python3.12

# Create Python virtual environment, by that Python
RUN "$(UV_PYTHON_INSTALL_DIR=/opt/python uv python find --managed-python 3.12)" -m venv /opt/venv
ENV VIRTUAL_ENV="/opt/venv"
ENV PATH="/opt/venv/bin:$PATH"

# Set working directory
WORKDIR /workspace

# Cache-bust knob for the version-pinned PyPI east-py install in
# install-packages.sh. Pass --build-arg EAST_PY_CACHEBUST=$(date +%s) to force
# a re-fetch (e.g. if a PyPI yank/republish reused a version).
ARG EAST_PY_CACHEBUST=0

# Copy and run install script (Node.js + Python). A named release's python
# packages are installed under its pins: the east-py workspace's lock,
# exported, with its overrides, as the release's published @elaraai/e3-core
# ships them (e3: a project and its tier resolve the same torch). The script
# fetches them into /opt/e3, where they stay. `latest` is unconstrained, and
# keeps none.
COPY docker/images/install-packages.sh /tmp/install-packages.sh
RUN chmod +x /tmp/install-packages.sh && \
    EAST_PY_PINS_DIR=/opt/e3 /tmp/install-packages.sh && \
    rm /tmp/install-packages.sh

# (east-c is installed from npm by install-packages.sh — no build-stage copy.)

# Create compile environment for single-file type-checking
RUN mkdir -p /compile && \
    ln -s /usr/local/lib/node_modules /compile/node_modules && \
    echo '{"compilerOptions":{"target":"esnext","module":"nodenext","strict":true,"skipLibCheck":true,"noEmit":true}}' > /compile/tsconfig.json

# Create e3 data directory
RUN mkdir -p /root/.e3

# Default command
CMD ["bash"]
