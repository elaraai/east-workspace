# Lambda Runner Container Image
#
# Based on ghcr.io/elaraai/e3 which includes:
# - Node.js 22
# - Python 3.11 + east-py + east-py-std + east-py-io + east-py-datascience
# - e3 CLI and packages
#
# This image adds:
# - AWS Lambda Runtime Interface Client for Node.js
# - Runner handler code for task execution

FROM ghcr.io/elaraai/e3:beta

# Install build dependencies for aws-lambda-ric and then the RIC itself
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    g++ \
    make \
    autoconf \
    automake \
    libtool \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g aws-lambda-ric

# Create app directory
WORKDIR /app

# Copy the execute-task handler
COPY packages/e3-aws-runner/dist/src/handlers/execute-task.js ./dist/handlers/
COPY packages/e3-aws-runner/dist/src/handlers/execute-task.js.map ./dist/handlers/

# Create minimal package.json with only needed dependencies and install
RUN echo '{"type":"module","dependencies":{"@aws-sdk/client-s3":"^3.966.0","@aws-sdk/client-dynamodb":"^3.966.0","@aws-sdk/util-dynamodb":"^3.966.0"}}' > package.json \
    && npm install --omit=dev

# Copy storage package AFTER npm install (to avoid being cleaned up)
# Must preserve the dist/src structure to match package.json "main": "dist/src/index.js"
COPY packages/e3-aws-storage/dist/src ./node_modules/@elaraai/e3-aws-storage/dist/src
COPY packages/e3-aws-storage/package.json ./node_modules/@elaraai/e3-aws-storage/

# Lambda entrypoint - use aws-lambda-ric to bootstrap
ENTRYPOINT ["/usr/local/bin/npx", "aws-lambda-ric"]

# Default handler - execute-task
CMD ["dist/handlers/execute-task.handler"]
